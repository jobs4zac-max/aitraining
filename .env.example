# UdaPlay environment template.
#   cp .env.example .env      then fill in your key.
# Never commit the real .env -- it is gitignored.
#
# The project reads .env first, then config.env (the name used in the project
# requirements). Whichever loads first wins, so .env takes precedence.

# Vocareum-issued keys start with "voc-" and are served by Vocareum's own
# OpenAI-compatible proxy, not by api.openai.com.
OPENAI_API_KEY="voc-..."

# Base URL for the OpenAI-compatible endpoint.
# Leave this as-is for a Vocareum key. If you ever switch to a standard
# "sk-..." OpenAI key, comment this line out.
# (It can also be omitted entirely: a "voc-" prefixed key auto-selects the
# Vocareum URL. Setting it explicitly is clearer.)
OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Models. Override the embedding model if the proxy does not serve
# text-embedding-3-small -- text-embedding-ada-002 is the usual fallback.
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Results requested per web-search backend.
SEARCH_MAX_RESULTS=4

# No web-search key is needed: Wikipedia and DuckDuckGo are both keyless.
